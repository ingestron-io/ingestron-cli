{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ingestron.io/cli/ingestron-azure-config-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "target",
    "profile",
    "identity",
    "artifacts",
    "cost",
    "tags",
    "bundle"
  ],
  "properties": {
    "apiVersion": { "const": "ingestron.azure/v1" },
    "kind": { "const": "AzureInstallation" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "subscriptionId",
        "subscriptionName",
        "resourceGroupName",
        "location"
      ],
      "properties": {
        "tenantId": { "$ref": "#/$defs/uuid" },
        "subscriptionId": { "$ref": "#/$defs/uuid" },
        "subscriptionName": { "type": "string", "minLength": 1 },
        "resourceGroupName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 90
        },
        "location": { "type": "string", "pattern": "^[a-z0-9-]{2,40}$" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "resourceSuffix",
        "deploymentMode",
        "apiIngressMode"
      ],
      "properties": {
        "name": { "const": "profile-j" },
        "resourceSuffix": { "type": "string", "pattern": "^[a-z0-9]{6,12}$" },
        "deploymentMode": { "enum": ["temporary-proof", "persistent-demo"] },
        "apiIngressMode": { "enum": ["disabled", "entra-public"] }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entraApplicationClientId",
        "allowedClientApplicationIds",
        "pipelineCallerPrincipalId"
      ],
      "properties": {
        "entraApplicationClientId": { "$ref": "#/$defs/uuid" },
        "allowedClientApplicationIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/uuid" }
        },
        "pipelineCallerPrincipalId": { "$ref": "#/$defs/uuid" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workerImageSource", "jobsFunctionsPackage"],
      "properties": {
        "workerImageSource": {
          "type": "string",
          "pattern": "^https://[^/?#]+/[^?#]+@sha256:[a-f0-9]{64}$"
        },
        "jobsFunctionsPackage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plannedUsd"],
      "properties": {
        "plannedUsd": { "type": "number", "exclusiveMinimum": 0, "maximum": 50 }
      }
    },
    "tags": {
      "type": "object",
      "additionalProperties": { "type": "string", "maxLength": 256 }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "digest"],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    }
  }
}
