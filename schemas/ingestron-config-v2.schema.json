{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ingestron.io/cli/config/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "target",
    "profile",
    "recipe",
    "connections",
    "integration",
    "bundle"
  ],
  "properties": {
    "apiVersion": { "const": "ingestron.cli/v2" },
    "kind": { "const": "AdfInstallation" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factoryResourceId"],
      "properties": {
        "factoryResourceId": {
          "type": "string",
          "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/resourceGroups/[^/]+/providers/Microsoft\\.DataFactory/factories/[^/]+$"
        }
      }
    },
    "profile": {
      "enum": [
        "hosted-transient",
        "hosted-registered-storage",
        "customer-managed"
      ]
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "connections": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,62}$" },
      "additionalProperties": { "$ref": "#/$defs/connection" }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "audience", "pipelineName"],
      "properties": {
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "audience": {
          "type": "string",
          "pattern": "^api://[0-9a-fA-F-]{36}$"
        },
        "pipelineName": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,126}$"
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "digest"],
      "properties": {
        "version": { "const": "2.0.4" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  },
  "$defs": {
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linkedService", "store", "namespace", "capability"],
      "properties": {
        "linkedService": { "type": "string", "minLength": 1, "maxLength": 127 },
        "store": { "enum": ["AzureBlobStorage", "AzureBlobFS"] },
        "account": { "type": "string", "pattern": "^[a-z0-9]{3,24}$" },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "capability": { "enum": ["read", "write", "read-write"] }
      }
    }
  }
}
