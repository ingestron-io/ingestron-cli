{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ingestron.io/cli/recipe/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "source", "destination"],
  "properties": {
    "outcome": { "const": "workbook.to-governed-dataset" },
    "source": { "$ref": "#/$defs/reference" },
    "destination": { "$ref": "#/$defs/reference" }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connection", "path"],
      "properties": {
        "connection": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    }
  }
}
