{
  "schemaVersion": 1,
  "contract": "ingestron.azure-bundle/v1",
  "bundleVersion": "1.9.0",
  "profile": "profile-j",
  "minimumCliVersion": "0.3.11-preview.1",
  "deploymentModes": ["temporary-proof", "persistent-demo"],
  "ingressModes": ["disabled", "entra-public"],
  "monthlyCostCeilingUsd": 50,
  "templates": {
    "foundation": "profile-j-foundation.json",
    "runtime": "profile-j-runtime.json"
  },
  "applicationDeploymentHelper": "azure-one-deploy.mjs",
  "applicationArtifacts": {
    "jobsFunctions": {
      "version": "0.6.0-preview.1",
      "sha256": "fecda3d6f749730f83c240a5734498afad9bf68121e1c43d6c0a11d0371f946e",
      "fileName": "ingestron-jobs-0.6.0-preview.1-fecda3d6f749.zip",
      "downloadUrl": "https://github.com/ingestron-io/ingestron-azure/releases/download/v0.4.7-preview.1/ingestron-jobs-0.6.0-preview.1-fecda3d6f749.zip",
      "license": "LicenseRef-Ingestron-Runtime-Preview-1.0"
    },
    "workerImage": {
      "registry": "ghcr.io/ingestron-io",
      "repository": "ingestron-jobs-worker",
      "sha256": "9ea98d1c80cefb0c96fa5997a85b7268ba8a391bdd88200670bbe7b56ecead9f",
      "license": "LicenseRef-Ingestron-Runtime-Preview-1.0"
    }
  },
  "licensing": {
    "source": "Apache-2.0",
    "runtime": "LicenseRef-Ingestron-Runtime-Preview-1.0",
    "runtimeLicenseFile": "LICENSE-RUNTIME-PREVIEW.md"
  },
  "parameters": {
    "safeConfiguration": [
      "tenantId",
      "subscriptionId",
      "resourceGroupName",
      "location",
      "resourceSuffix",
      "deploymentMode",
      "apiIngressMode",
      "entraApplicationClientId",
      "allowedClientApplicationIds",
      "pipelineCallerPrincipalId",
      "workerImageSource",
      "jobsFunctionsPackage",
      "tags"
    ],
    "secretsForbidden": true
  },
  "outputs": [
    "endpoint",
    "audience",
    "tenantId",
    "storageAccount",
    "sourceContainer",
    "packageContainer"
  ],
  "changePolicy": {
    "foundationAllowed": ["Create", "Ignore", "NoChange"],
    "runtimeAllowed": ["Create", "Ignore", "NoChange", "Modify"],
    "deletionAllowed": false,
    "replacementAllowed": false,
    "ownedResourceGroup": true
  },
  "lifecyclePolicy": {
    "contract": "ingestron.azure-lifecycle/v1",
    "defaultScope": "cost-bearing",
    "scopes": {
      "cost-bearing": ["jobs-api-trigger"],
      "all": ["jobs-api-trigger"]
    },
    "targets": {
      "jobs-api-trigger": {
        "kind": "azure-function-trigger",
        "resourceType": "Microsoft.Web/sites",
        "nameTemplate": "func-ing-j-{resourceSuffix}",
        "functionName": "submitIngestronJob",
        "disabledSetting": "AzureWebJobs.submitIngestronJob.Disabled",
        "costClass": "consumption-workload-intake"
      }
    },
    "residualCostClasses": [
      "in-flight-job-execution",
      "storage-retention",
      "container-registry-retention",
      "network-and-monitoring-usage"
    ],
    "dropScope": "owned-resource-group-only"
  },
  "adoptionPolicy": {
    "contract": "ingestron.azure-adoption/v1",
    "supportedIngressModes": ["entra-public"],
    "requiredResources": [
      {
        "resourceType": "Microsoft.ManagedIdentity/userAssignedIdentities",
        "nameTemplate": "id-ing-j-{resourceSuffix}"
      },
      {
        "resourceType": "Microsoft.ContainerRegistry/registries",
        "nameTemplate": "ingjcr{resourceSuffix}"
      },
      {
        "resourceType": "Microsoft.App/managedEnvironments",
        "nameTemplate": "cae-ing-j-{resourceSuffix}"
      },
      {
        "resourceType": "Microsoft.Storage/storageAccounts",
        "nameTemplate": "ingj{resourceSuffix}"
      },
      {
        "resourceType": "Microsoft.Web/serverFarms",
        "nameTemplate": "plan-ing-j-{resourceSuffix}"
      },
      {
        "resourceType": "Microsoft.Web/sites",
        "nameTemplate": "func-ing-j-{resourceSuffix}"
      },
      {
        "resourceType": "Microsoft.App/jobs",
        "nameTemplate": "job-ing-j-{resourceSuffix}"
      }
    ]
  },
  "rollback": {
    "minimumRetainedLocks": 2,
    "automatic": false,
    "requiresCompatibleBundle": true
  }
}
